# Скопируйте в `.env` для локальной разработки (`vercel dev`) — НЕ коммитьте `.env`.
# На Vercel задайте это значение в Project Settings → Environment Variables.

# Ключ Anthropic. Используется ТОЛЬКО серверless-функцией /api/extract,
# в браузер никогда не попадает.
ANTHROPIC_API_KEY=sk-ant-...

# (необязательно) Переопределить модель. По умолчанию claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Notion (для кнопки «Сохранить в Notion»). Используются только /api/save-to-notion.
# Токен внутренней интеграции Notion и ID базы «Задачи».
# База должна иметь title-свойство «Тема» и (необязательно) свойство «Дата» типа date.
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...

# (необязательно) База «Задачи» в Notion. Если задана, /api/save-to-notion
# создаёт по строке на каждую задачу протокола.
# Колонки: Задача (title), Ответственный (text), Срок (text),
# Приоритет (select), Статус (select), Совещание (text).
# NOTION_TASKS_DB_ID=...

# Рассылка задач в Telegram (для /api/notify-telegram):
# токен бота @BotFather и база «Контакты» в Notion (Имя=title, колонка «Telegram»).
# В «Telegram» нужен числовой chat_id (телефон/@username не подойдут).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# NOTION_CONTACTS_DB_ID=...
