# Скопируйте в `.env` для локальной разработки (`vercel dev`) — НЕ коммитьте `.env`.
# На Vercel задайте это значение в Project Settings → Environment Variables.

# Ключ Anthropic. Используется ТОЛЬКО серверless-функцией /api/extract,
# в браузер никогда не попадает.
ANTHROPIC_API_KEY=sk-ant-...

# (необязательно) Переопределить модель. По умолчанию claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6
